#include "mbed.h"
#include <cstdint>

// Declaración de BusOut para las secuencias de LEDs
BusOut MATRIZ_S1(PA_9, PA_15, PB_6, PB_5, PA_12, PA_8, PB_12, PB_13, PB_14, PB_15, PA_11, PB_4, PB_8, PB_7, PB_3, PA_10);
BusOut MATRIZ_S2_SA(PB_13, PA_9, PA_8, PA_12, PB_5, PA_15);
BusOut MATRIZ_S2_SB(PB_7, PB_3, PB_4, PA_11, PB_15, PA_10);
BusOut MATRIZ_S3(PB_5, PB_6, PA_12, PB_7, PA_8, PA_15, PB_8, PB_12, PA_9, PB_3, PB_13, PA_10, PB_4, PB_14, PA_11, PB_15);
BusOut MATRIZ_S4(PA_11, PB_14, PB_13, PA_8, PA_12, PB_6, PB_7, PB_4, PA_10, PA_9, PA_15, PB_3);
BusOut MATRIZ_S5_SA(PA_8, PB_13, PA_10, PB_15, PA_11, PB_14, PA_9, PB_12);
BusOut MATRIZ_S5_SB(PA_12, PB_6, PB_3, PB_8, PB_4, PB_7, PA_15, PB_5);

// Bus de entrada DIPSWITCH
BusIn DIPSW(PC_14, PC_15, PA_0, PA_1);

void S1() {
    uint16_t SA = 1;
    MATRIZ_S1 = 0;
    wait_us(400000);
    for (uint8_t i = 0; i < 16; i++) {
        MATRIZ_S1 = SA;
        wait_us(400000);
        SA = (SA << 1) | 1;
    }
    SA = 65534;
    for (uint8_t i = 0; i < 16; i++) {
        MATRIZ_S1 = SA;
        wait_us(400000);
        SA = SA << 1;
    }
}

void S2() {
    uint16_t SA = 1, SB = 1;
    MATRIZ_S2_SA = 0;
    MATRIZ_S2_SB = 0;
    wait_us(500000);
    for (int i = 0; i < 6; i++) {
        MATRIZ_S2_SA = SA;
        MATRIZ_S2_SB = SB;
        wait_us(500000);
        SA = (SA << 1) | 1;
        SB = (SB << 1) | 1;
    }
}

void S3() {
    uint16_t SA = 0;
    MATRIZ_S3 = SA;
    wait_us(500000);
    for (int i = 0; i < 16; i++) {
        SA |= (1 << i);
        MATRIZ_S3 = SA;
        wait_us(500000);
    }
    for (int i = 15; i >= 0; i--) {
        SA &= ~(1 << i);
        MATRIZ_S3 = SA;
        wait_us(500000);
    }
}

void S4() {
    uint16_t SA = 0;
    MATRIZ_S4 = SA;
    wait_us(400000);
    
    // Encender en secuencia de 1 a 12
    for (int i = 0; i < 12; i++) {
        SA |= (1 << i);
        MATRIZ_S4 = SA;
        wait_us(400000);
    }
    
    // Apagar en secuencia de 12 a 1
    for (int i = 11; i >= 0; i--) {
        SA &= ~(1 << i);
        MATRIZ_S4 = SA;
        wait_us(400000);
    }
}

void S5() {
    uint16_t SA = 1, SB = 1;
    MATRIZ_S5_SA = 0;
    MATRIZ_S5_SB = 0;
    wait_us(500000);
    for (int i = 0; i < 4; i++) {
        MATRIZ_S5_SA = SA;
        MATRIZ_S5_SB = SB;
        wait_us(500000);
        SA = (SA << 1) | 1;
        SB = (SB << 1) | 1;
    }
    SA = 16;
    SB = 16;
    for (int i = 5; i < 9; i++) {
        MATRIZ_S5_SA = SA;
        MATRIZ_S5_SB = SB;
        wait_us(500000);
        SA = SA << 1;
        SB = SB << 1;
    }
}

int main() {
    while (true) {
        switch (DIPSW) {
            case 0: S1(); break;
            case 1: S2(); break;
            case 2: S3(); break;
            case 3: S4(); break;
            case 4: S5(); break;
            default: MATRIZ_S1 = 0; break;
        }
    }
}
